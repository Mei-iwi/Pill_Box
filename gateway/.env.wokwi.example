# Copy to gateway/.env once to select the Wokwi/MQTT Gateway.
# Public broker: use synthetic/pseudonymous test data only.
PILLBOX_MODE=mqtt
PILLBOX_DB=gateway/data/pillbox.db
PILLBOX_AUTH_FILE=gateway/auth.local.json
PILLBOX_BIND=127.0.0.1
PORT=5000
PILLBOX_MQTT_AUTOSTART=1
PILLBOX_HTTP_INGEST=0
MQTT_HOST=test.mosquitto.org
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USER=
MQTT_PASSWORD=

# Private TLS broker: use matching firmware settings and a trusted CA.
# MQTT_HOST=mqtt.example.com
# MQTT_PORT=8883
# MQTT_TLS=1
# MQTT_CA_FILE=deploy/runtime/certs/ca.crt
# MQTT_USER=gateway
# MQTT_PASSWORD=fill-locally
# PILLBOX_DEPLOYMENT=care
