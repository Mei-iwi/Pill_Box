# Copy to gateway/.env once. Never commit the local .env file.
# Paths are relative to the repository root; use / on Windows too.
PILLBOX_MODE=local
PILLBOX_DB=gateway/data/pillbox.db
PILLBOX_AUTH_FILE=gateway/auth.local.json
PILLBOX_BIND=127.0.0.1
PORT=5000

# Local mode always disables external MQTT. Manual HTTP ingest can be turned off.
PILLBOX_MQTT_AUTOSTART=0
PILLBOX_HTTP_INGEST=1
MQTT_HOST=test.mosquitto.org
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USER=
MQTT_PASSWORD=

# Optional SMTP: inspected by CLI only; no mail is sent unless --send is used.
# PILLBOX_SMTP_HOST=smtp.example.com
# PILLBOX_SMTP_PORT=587
# PILLBOX_SMTP_FROM=pillbox@example.com
# PILLBOX_SMTP_TO=caregiver@example.com
# PILLBOX_SMTP_USER=
# PILLBOX_SMTP_PASSWORD=
